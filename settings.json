{
  "alwaysThinkingEnabled": true,
  "effortLevel": "medium",
  "enabledPlugins": {
    "caveman@caveman": true,
    "gopls-lsp@claude-plugins-official": true
  },
  "env": {
    "ENABLE_TOOL_SEARCH": "true"
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "repo": "JuliusBrussee/caveman",
        "source": "github"
      }
    }
  },
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "$HOME/.claude/skills/continuous-learning/hooks/observer.sh",
            "type": "command"
          }
        ],
        "matcher": "*"
      },
      {
        "hooks": [
          {
            "command": "atuin hook claude-code",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "command": "atuin hook claude-code",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "$HOME/.claude/skills/continuous-learning/hooks/observer.sh",
            "type": "command"
          }
        ],
        "matcher": "*"
      },
      {
        "hooks": [
          {
            "command": "/home/gbr/.claude/hooks/rtk-rewrite.sh",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "atuin hook claude-code",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ]
  },
  "mcpServers": {
    "atlassian": {
      "args": [
        "mcp-atlassian"
      ],
      "command": "uvx",
      "env": {
        "JIRA_API_TOKEN": "${JIRA_API_TOKEN}",
        "JIRA_URL": "${JIRA_URL}",
        "JIRA_USERNAME": "${JIRA_USERNAME}"
      }
    }
  },
  "permissions": {
    "allow": [
      "Read(~/.claude)",
      "Bash(find:*)",
      "Bash(head:*)",
      "Bash(grep:*)",
      "Bash(mvn:*)",
      "Bash(mvn validate:*)",
      "Bash(mvn dependency:tree:*)",
      "Bash(mvn help:evaluate:*)",
      "Bash(mvn help:active-profiles:*)",
      "Bash(mvn help:describe:*)",
      "Bash(mvn clean compile:*)",
      "Bash(mvn package:*)",
      "Bash(mvn compile:*)",
      "Bash(./mvnw clean compile:*)",
      "Bash(./mvnw test:*)",
      "Bash(cat:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git pull:*)",
      "Bash(git tag:*)",
      "Bash(git status:*)",
      "Bash(git fetch:*)",
      "Bash(tee:*)",
      "Bash(tree:*)",
      "WebSearch",
      "Bash(curl:*)",
      "Bash(ls:*)",
      "Bash(awk:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh api:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(wc:*)",
      "Bash(aws:*)",
      "Bash(jar tf:*)",
      "Bash(javap:*)"
    ]
  },
  "statusLine": {
    "command": "~/.claude/scripts/context-bar.sh",
    "type": "command"
  }
}